diff --git a/larsim/DetectorVariation/DetVarSummary_module.cc b/larsim/DetectorVariation/DetVarSummary_module.cc
new file mode 100644
index 00000000..998d1483
--- /dev/null
+++ b/larsim/DetectorVariation/DetVarSummary_module.cc
@@ -0,0 +1,71 @@
+////////////////////////////////////////////////////////////////////////
+/// \file  DetVarSummary_module.cc
+/// \brief One line per event: the thrown dials and the ionization they produced.
+///
+/// Purely a validation tool for the per-event variation prototype. It prints
+/// the event ID, the dial values the DetectorVariation service threw for that
+/// event, and the total number of ionization electrons in the
+/// SimEnergyDeposit collection -- which is the quantity ModBoxA/ModBoxB
+/// actually change. Comparing two runs, one nominal and one varied, shows the
+/// variation is real and event-by-event rather than job-wide.
+////////////////////////////////////////////////////////////////////////
+
+#include "art/Framework/Core/EDAnalyzer.h"
+#include "art/Framework/Core/ModuleMacros.h"
+#include "art/Framework/Principal/Event.h"
+#include "art/Framework/Services/Registry/ServiceHandle.h"
+#include "art/Framework/Services/Registry/ServiceRegistry.h"
+#include "canvas/Utilities/InputTag.h"
+#include "fhiclcpp/ParameterSet.h"
+#include "lardataobj/Simulation/SimEnergyDeposit.h"
+#include "larsim/DetectorVariation/DetectorVariation.h"
+
+#include <iomanip>
+#include <iostream>
+#include <string>
+
+namespace snowstorm {
+
+  class DetVarSummary : public art::EDAnalyzer {
+  public:
+    explicit DetVarSummary(fhicl::ParameterSet const& p)
+      : art::EDAnalyzer{p}, fTag{p.get<art::InputTag>("SimEnergyDepositLabel", "IonAndScint")}
+    {}
+    void analyze(art::Event const& e) override;
+
+  private:
+    art::InputTag fTag;
+  };
+
+  void DetVarSummary::analyze(art::Event const& e)
+  {
+    double energy = 0., electrons = 0.;
+    long ndepos = 0;
+    art::Handle<std::vector<sim::SimEnergyDeposit>> h;
+    if (e.getByLabel(fTag, h)) {
+      for (auto const& d : *h) {
+        energy += d.Energy();
+        electrons += d.NumElectrons();
+        ++ndepos;
+      }
+    }
+
+    std::string key = "-";
+    double alpha = 0., beta = 0.;
+    if (art::ServiceRegistry::isAvailable<DetectorVariation>()) {
+      art::ServiceHandle<DetectorVariation const> var;
+      key = var->currentKey();
+      if (var->has("alpha")) alpha = var->value("alpha");
+      if (var->has("beta")) beta = var->value("beta");
+    }
+
+    std::cout << "DVSUMMARY"
+              << " run=" << e.id().run() << " subrun=" << e.id().subRun()
+              << " event=" << e.id().event() << " key=" << key << std::setprecision(17)
+              << " alpha=" << alpha << " beta=" << beta << " ndepos=" << ndepos
+              << " energy=" << energy << " electrons=" << electrons << std::endl;
+  }
+
+}
+
+DEFINE_ART_MODULE(snowstorm::DetVarSummary)
diff --git a/larsim/DetectorVariation/DetectorVariation.h b/larsim/DetectorVariation/DetectorVariation.h
new file mode 100644
index 00000000..235ac7d5
--- /dev/null
+++ b/larsim/DetectorVariation/DetectorVariation.h
@@ -0,0 +1,81 @@
+////////////////////////////////////////////////////////////////////////
+/// \file  DetectorVariation.h
+/// \brief SnowStorm-style detector-parameter variation, per file or per event.
+///
+/// The service owns the throw. Given a job key and a set of dial definitions
+/// it produces, for every event, a value per dial. The throw is a pure
+/// function of (job key, run, subrun, event, dial name) -- no state, no
+/// central bookkeeping, and identical to the Python sampler
+/// (snowstorm_params.py) bit for bit, so any event's parameters can be
+/// recomputed offline from its event ID alone.
+///
+/// Prototype for the SnowStorm-with-justIN work. In production this belongs
+/// in dunesw, not larsim; it lives here only so that a single package build
+/// exercises both the service and the IonAndScint hook.
+////////////////////////////////////////////////////////////////////////
+#ifndef SNOWSTORM_DETECTORVARIATION_H
+#define SNOWSTORM_DETECTORVARIATION_H
+
+#include "art/Framework/Services/Registry/ServiceDeclarationMacros.h"
+#include "fhiclcpp/ParameterSet.h"
+
+#include <map>
+#include <string>
+#include <vector>
+
+namespace art {
+  class ActivityRegistry;
+  class Event;
+  class ScheduleContext;
+  class Run;
+}
+
+namespace snowstorm {
+
+  class DetectorVariation {
+  public:
+    DetectorVariation(fhicl::ParameterSet const& pset, art::ActivityRegistry& reg);
+
+    /// Is this dial defined?
+    bool has(std::string const& dial) const { return fDials.count(dial) > 0; }
+
+    /// Value of the dial for the event currently being processed.
+    double value(std::string const& dial) const;
+
+    /// "perFile" or "perEvent".
+    std::string const& policy() const { return fPolicy; }
+
+    /// The key the current values were thrown from: the job key for perFile,
+    /// "<jobkey>/<run>/<subrun>/<event>" for perEvent. This string is the
+    /// whole provenance -- feed it back to the sampler and you get the values.
+    std::string const& currentKey() const { return fCurrentKey; }
+
+    /// All current values, for logging or for writing into the event.
+    std::map<std::string, double> const& values() const { return fValues; }
+
+  private:
+    struct Dial {
+      std::string dist;   ///< "gaus", "uniform", "loguniform", "fixed"
+      double nominal{0.}; ///< gaus centre
+      double sigma{0.};   ///< gaus width
+      double lo{0.};      ///< range/clip low
+      double hi{0.};      ///< range/clip high
+      bool clip{false};
+      double fixed{0.};
+    };
+
+    void throwFor(std::string const& key);
+    void preProcessEvent(art::Event const& evt, art::ScheduleContext);
+
+    std::map<std::string, Dial> fDials;
+    std::map<std::string, double> fValues;
+    std::string fKey;        ///< job key, e.g. the justIN counter key "w20169-1"
+    std::string fPolicy;     ///< perFile | perEvent
+    std::string fCurrentKey; ///< key the current values were thrown from
+  };
+
+}
+
+DECLARE_ART_SERVICE(snowstorm::DetectorVariation, SHARED)
+
+#endif
diff --git a/larsim/DetectorVariation/DetectorVariation_service.cc b/larsim/DetectorVariation/DetectorVariation_service.cc
new file mode 100644
index 00000000..a999dfa1
--- /dev/null
+++ b/larsim/DetectorVariation/DetectorVariation_service.cc
@@ -0,0 +1,123 @@
+////////////////////////////////////////////////////////////////////////
+/// \file  DetectorVariation_service.cc
+/// \brief Implementation of the SnowStorm detector-parameter variation service.
+////////////////////////////////////////////////////////////////////////
+
+#include "larsim/DetectorVariation/DetectorVariation.h"
+#include "larsim/DetectorVariation/sha256_mini.h"
+
+#include "art/Framework/Principal/Event.h"
+#include "art/Framework/Services/Registry/ActivityRegistry.h"
+#include "art/Framework/Services/Registry/ServiceDefinitionMacros.h"
+#include "canvas/Persistency/Provenance/EventID.h"
+#include "messagefacility/MessageLogger/MessageLogger.h"
+
+#include <cmath>
+#include <iomanip>
+#include <sstream>
+#include <stdexcept>
+
+namespace snowstorm {
+
+  DetectorVariation::DetectorVariation(fhicl::ParameterSet const& pset, art::ActivityRegistry& reg)
+    : fKey{pset.get<std::string>("key")}
+    , fPolicy{pset.get<std::string>("policy", "perFile")}
+  {
+    if (fPolicy != "perFile" && fPolicy != "perEvent")
+      throw std::runtime_error("DetectorVariation: policy must be perFile or perEvent, got " +
+                               fPolicy);
+
+    auto const dials = pset.get<fhicl::ParameterSet>("dials");
+    for (auto const& name : dials.get_pset_names()) {
+      auto const d = dials.get<fhicl::ParameterSet>(name);
+      Dial dial;
+      dial.dist = d.get<std::string>("dist");
+      if (dial.dist == "fixed") { dial.fixed = d.get<double>("value"); }
+      else if (dial.dist == "gaus") {
+        dial.nominal = d.get<double>("nominal");
+        dial.sigma = d.get<double>("sigma");
+        auto const clip = d.get<std::vector<double>>("clip", {});
+        if (clip.size() == 2) {
+          dial.clip = true;
+          dial.lo = clip[0];
+          dial.hi = clip[1];
+        }
+      }
+      else if (dial.dist == "uniform" || dial.dist == "loguniform") {
+        auto const range = d.get<std::vector<double>>("range");
+        dial.lo = range[0];
+        dial.hi = range[1];
+      }
+      else {
+        throw std::runtime_error("DetectorVariation: unknown dist " + dial.dist + " for dial " +
+                                 name);
+      }
+      fDials[name] = dial;
+    }
+
+    // A perFile job throws once, now, and never again; a perEvent job rethrows
+    // for every event. Throwing here in both cases means value() is always
+    // defined, even for modules that run before the first event.
+    throwFor(fKey);
+
+    if (fPolicy == "perEvent")
+      reg.sPreProcessEvent.watch(this, &DetectorVariation::preProcessEvent);
+
+    mf::LogInfo("DetectorVariation")
+      << "policy=" << fPolicy << " key=" << fKey << " dials=" << fDials.size();
+  }
+
+  //......................................................................
+  void DetectorVariation::throwFor(std::string const& key)
+  {
+    fCurrentKey = key;
+    for (auto const& [name, d] : fDials) {
+      double val = 0.;
+      if (d.dist == "fixed") { val = d.fixed; }
+      else if (d.dist == "uniform") {
+        val = d.lo + (d.hi - d.lo) * uniform(key, name);
+      }
+      else if (d.dist == "loguniform") {
+        val = std::exp(std::log(d.lo) + (std::log(d.hi) - std::log(d.lo)) * uniform(key, name));
+      }
+      else { // gaus, Box-Muller on two independent streams
+        double const u1 = std::max(uniform(key, name + ":u1"), 1e-12);
+        double const u2 = uniform(key, name + ":u2");
+        double const z = std::sqrt(-2.0 * std::log(u1)) * std::cos(2.0 * M_PI * u2);
+        val = d.nominal + d.sigma * z;
+        if (d.clip) val = std::min(std::max(val, d.lo), d.hi);
+      }
+      fValues[name] = val;
+    }
+  }
+
+  //......................................................................
+  void DetectorVariation::preProcessEvent(art::Event const& evt, art::ScheduleContext)
+  {
+    auto const& id = evt.id();
+    std::ostringstream key;
+    key << fKey << "/" << id.run() << "/" << id.subRun() << "/" << id.event();
+    throwFor(key.str());
+
+    std::ostringstream msg;
+    msg << "key=" << fCurrentKey;
+    for (auto const& [name, val] : fValues)
+      msg << " " << name << "=" << std::setprecision(17) << val;
+    mf::LogInfo("DetectorVariation") << msg.str();
+    // Printed unconditionally as well: this line is what the validation script
+    // parses, and MessageFacility thresholds vary between production fcls.
+    std::cout << "DetectorVariation throw " << msg.str() << std::endl;
+  }
+
+  //......................................................................
+  double DetectorVariation::value(std::string const& dial) const
+  {
+    auto const it = fValues.find(dial);
+    if (it == fValues.end())
+      throw std::runtime_error("DetectorVariation: no such dial: " + dial);
+    return it->second;
+  }
+
+}
+
+DEFINE_ART_SERVICE(snowstorm::DetectorVariation)
diff --git a/larsim/DetectorVariation/sha256_mini.h b/larsim/DetectorVariation/sha256_mini.h
new file mode 100644
index 00000000..7450e919
--- /dev/null
+++ b/larsim/DetectorVariation/sha256_mini.h
@@ -0,0 +1,117 @@
+////////////////////////////////////////////////////////////////////////
+/// \file sha256_mini.h
+/// \brief Minimal self-contained SHA-256, used only to make the C++ throw
+///        bit-for-bit identical to the Python sampler (snowstorm_params.py).
+///
+/// Deliberately not OpenSSL: the point is that the same short, auditable
+/// function exists on both sides, so a parameter value can be recomputed
+/// offline from an event ID without running LArSoft at all.
+////////////////////////////////////////////////////////////////////////
+#ifndef SNOWSTORM_SHA256_MINI_H
+#define SNOWSTORM_SHA256_MINI_H
+
+#include <cstdint>
+#include <cstring>
+#include <string>
+
+namespace snowstorm {
+
+  namespace detail {
+    inline uint32_t rotr(uint32_t x, uint32_t n) { return (x >> n) | (x << (32 - n)); }
+
+    constexpr uint32_t k[64] = {
+      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4,
+      0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe,
+      0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f,
+      0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+      0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc,
+      0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
+      0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116,
+      0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+      0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
+      0xc67178f2};
+  }
+
+  /// SHA-256 of a string; writes 32 bytes into digest.
+  inline void sha256(std::string const& msg, unsigned char digest[32])
+  {
+    uint32_t h[8] = {0x6a09e667,
+                     0xbb67ae85,
+                     0x3c6ef372,
+                     0xa54ff53a,
+                     0x510e527f,
+                     0x9b05688c,
+                     0x1f83d9ab,
+                     0x5be0cd19};
+
+    // message + 0x80 + zero padding + 64-bit big-endian bit length
+    uint64_t const bitlen = static_cast<uint64_t>(msg.size()) * 8;
+    std::string data = msg;
+    data.push_back(static_cast<char>(0x80));
+    while (data.size() % 64 != 56)
+      data.push_back('\0');
+    for (int i = 7; i >= 0; --i)
+      data.push_back(static_cast<char>((bitlen >> (i * 8)) & 0xff));
+
+    for (size_t off = 0; off < data.size(); off += 64) {
+      uint32_t w[64];
+      for (int i = 0; i < 16; ++i) {
+        unsigned char const* p = reinterpret_cast<unsigned char const*>(data.data()) + off + i * 4;
+        w[i] = (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3];
+      }
+      for (int i = 16; i < 64; ++i) {
+        uint32_t const s0 =
+          detail::rotr(w[i - 15], 7) ^ detail::rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+        uint32_t const s1 =
+          detail::rotr(w[i - 2], 17) ^ detail::rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+      }
+
+      uint32_t a = h[0], b = h[1], c = h[2], d = h[3];
+      uint32_t e = h[4], f = h[5], g = h[6], hh = h[7];
+
+      for (int i = 0; i < 64; ++i) {
+        uint32_t const S1 = detail::rotr(e, 6) ^ detail::rotr(e, 11) ^ detail::rotr(e, 25);
+        uint32_t const ch = (e & f) ^ ((~e) & g);
+        uint32_t const t1 = hh + S1 + ch + detail::k[i] + w[i];
+        uint32_t const S0 = detail::rotr(a, 2) ^ detail::rotr(a, 13) ^ detail::rotr(a, 22);
+        uint32_t const maj = (a & b) ^ (a & c) ^ (b & c);
+        uint32_t const t2 = S0 + maj;
+        hh = g;
+        g = f;
+        f = e;
+        e = d + t1;
+        d = c;
+        c = b;
+        b = a;
+        a = t1 + t2;
+      }
+      h[0] += a; h[1] += b; h[2] += c; h[3] += d;
+      h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
+    }
+
+    for (int i = 0; i < 8; ++i) {
+      digest[i * 4 + 0] = (h[i] >> 24) & 0xff;
+      digest[i * 4 + 1] = (h[i] >> 16) & 0xff;
+      digest[i * 4 + 2] = (h[i] >> 8) & 0xff;
+      digest[i * 4 + 3] = h[i] & 0xff;
+    }
+  }
+
+  /// Deterministic uniform on [0,1) from (key, salt).
+  ///
+  /// Exactly the recipe used by snowstorm_params.py: SHA-256 of "key/salt",
+  /// first 8 bytes big-endian, top 53 bits scaled by 2^-53 -- the same 53-bit
+  /// construction CPython's random.random() uses, so the double is exact.
+  inline double uniform(std::string const& key, std::string const& salt)
+  {
+    unsigned char d[32];
+    sha256(key + "/" + salt, d);
+    uint64_t v = 0;
+    for (int i = 0; i < 8; ++i)
+      v = (v << 8) | d[i];
+    return static_cast<double>(v >> 11) * (1.0 / 9007199254740992.0); // 2^-53
+  }
+
+}
+#endif
