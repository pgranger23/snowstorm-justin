diff --git a/larsim/IonizationScintillation/ISCalcCorrelated.h b/larsim/IonizationScintillation/ISCalcCorrelated.h
index da3a6024..54417370 100644
--- a/larsim/IonizationScintillation/ISCalcCorrelated.h
