# pe_dials.fcl is a PROLOG-only file and must come first: fhicl requires
# every PROLOG block to precede any non-prolog content.
#include "pe_dials.fcl"
#include "standard_g4_dune10kt_1x2x6.fcl"

# Same dials, thrown ONCE for the whole file -- the behaviour the per-file
# workflow already has, expressed through the same service so the two policies
# can be compared directly.
services.DetectorVariation: {
  key:    "w20169-1"
  policy: "perFile"
  dials:  @local::snowstorm_recomb_dials
}

physics.analyzers.dvsummary: {
  module_type: "DetVarSummary"
  SimEnergyDepositLabel: "IonAndScint"
}
physics.ana: [ dvsummary ]
physics.end_paths: [ stream1, ana ]
